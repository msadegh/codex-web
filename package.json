{
  "name": "codex-web",
  "version": "0.2.1",
  "type": "module",
  "description": "An unofficial, localhost-only browser interface for Codex CLI and Claude Code CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msadegh/codex-web.git"
  },
  "homepage": "https://github.com/msadegh/codex-web#readme",
  "bugs": {
    "url": "https://github.com/msadegh/codex-web/issues"
  },
  "bin": {
    "codex-web": "./server.mjs"
  },
  "files": [
    "public",
    "providers",
    "server.mjs",
    "README.md",
    "README.fa.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "start:no-open": "node server.mjs --no-open",
    "check": "node --check server.mjs && node --check public/app.js && node --check public/markdown.js",
    "test": "node --test"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "claude",
    "claude-code",
    "web-ui",
    "rtl",
    "persian"
  ],
  "author": "Mohammad Sadegh",
  "license": "MIT"
}
